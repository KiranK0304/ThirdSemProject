# Email
# -----
# Local Compose loads SMTP settings from .envs/.local/.django. Mailpit is the
# default there; set Gmail SMTP values in that file to deliver to real inboxes.
# Gmail App Passwords should be entered without display spaces.

# Docker host ports (read by `docker compose` from a local .env file)
# ---------------------------------
# Change these if another project already uses the default ports.
DJANGO_PORT=8000
FRONTEND_PORT=5173
MAILPIT_PORT=8025
